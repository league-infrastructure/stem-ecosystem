---
import { updateHref } from '../lib/updates/link.mjs';

interface Props {
  type: 'partner' | 'opportunity' | 'team' | 'club' | 'place';
  slug: string;
}
const { type, slug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const href = updateHref(base, type, slug);
---

<p class="update-link">
  Is something here wrong or out of date? <a href={href}>Request an update &rarr;</a>
</p>

<style>
  .update-link {
    margin-top: 28px;
    padding-top: 14px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    font-size: 14px;
  }
</style>
