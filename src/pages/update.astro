---
import BaseLayout from '../layouts/BaseLayout.astro';
import partners from '../data/partners.json';
import places from '../data/places.json';
import teams from '../data/teams.json';
import clubs from '../data/clubs.json';

const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // "" or "/partner-scrape"
const apiUrl = (import.meta.env.PUBLIC_UPDATES_API_URL || 'https://updates.jtlapp.net').replace(/\/+$/, '');

// Listing index for the picker: [type, slug, name], sorted by name.
const listings = [
  ...partners.filter((p) => p.slug).map((p) => ({ type: 'partner', slug: p.slug, name: p.name })),
  ...places.places.map((p) => ({ type: 'place', slug: p.place_id, name: p.name })),
  ...teams.teams.map((t) => ({ type: 'team', slug: t.team_id, name: t.name })),
  ...clubs.clubs.map((c) => ({ type: 'club', slug: c.club_id, name: c.name })),
].sort((a, b) => String(a.name).localeCompare(String(b.name)));
---

<BaseLayout
  title="Request an update | SD STEM Ecosystem"
  description="Tell us what is wrong or out of date on a listing and our assistant will help get it fixed."
>
  <section class="hero hero-sm">
    <h1>Request an update</h1>
  </section>

  <div class="update-page container" data-api-url={apiUrl} data-base={base}>
    <section class="update-explainer" aria-labelledby="update-how">
      <h2 id="update-how">How updates work</h2>
      <p>
        We only publish information that appears on your organization's own website. If a listing
        is wrong or out of date, tell our assistant where on your website the correct information
        can be found and what is currently wrong. The next scheduled scrape will pick up the
        change.
      </p>
      <p>
        Prefer email? Write to
        <a href="mailto:partners@sdstemecosystem.org">partners@sdstemecosystem.org</a>.
      </p>
      <noscript>
        <p class="update-noscript" role="note">
          The update assistant needs JavaScript. Without it, please email
          <a href="mailto:partners@sdstemecosystem.org">partners@sdstemecosystem.org</a> with the
          listing name and what needs to change.
        </p>
      </noscript>
    </section>

    <section class="update-picker" id="update-picker" aria-labelledby="picker-h" hidden>
      <h2 id="picker-h">Choose a listing</h2>
      <label for="picker-filter">Search listings</label>
      <input id="picker-filter" type="search" autocomplete="off" placeholder="Type a name" />
      <p id="picker-status" class="picker-status" aria-live="polite"></p>
      <ul id="picker-list" class="picker-list"></ul>
    </section>

    <div class="update-panels" id="update-panels" hidden>
      <section class="update-chat" id="update-chat" aria-labelledby="chat-h"
        data-api-url={apiUrl}>
        <h2 id="chat-h">Chat with the update assistant</h2>
        <div id="chat-transcript" class="chat-transcript" role="log" aria-live="polite"></div>
      </section>
      <aside class="update-hints" id="update-hints" aria-labelledby="hints-h" data-api-url={apiUrl}>
        <h2 id="hints-h">Scraping hints</h2>
        <div id="hints-body" class="hints-body"></div>
      </aside>
    </div>

    <script type="application/json" id="listing-index" set:html={JSON.stringify(listings).replace(/</g, '\\u003c')} />
  </div>
</BaseLayout>

<script>
  import { initUpdateChat } from '../scripts/update-chat';

  const page = document.querySelector<HTMLElement>('.update-page')!;
  const params = new URLSearchParams(location.search);
  const type = params.get('type');
  const slug = params.get('slug');
  const base = page.dataset.base || '';

  if (type && slug) {
    document.getElementById('update-panels')!.hidden = false;
    page.dataset.type = type;
    page.dataset.slug = slug;
    initUpdateChat(page, type, slug);
  } else {
    const listings: { type: string; slug: string; name: string }[] = JSON.parse(
      document.getElementById('listing-index')!.textContent || '[]',
    );
    const section = document.getElementById('update-picker')!;
    const filter = document.getElementById('picker-filter') as HTMLInputElement;
    const list = document.getElementById('picker-list')!;
    const status = document.getElementById('picker-status')!;
    section.hidden = false;

    const render = () => {
      const q = filter.value.trim().toLowerCase();
      const matches = listings.filter((l) => l.name.toLowerCase().includes(q));
      const shown = matches.slice(0, 50);
      list.replaceChildren(
        ...shown.map((l) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `${base}/update?${new URLSearchParams({ type: l.type, slug: l.slug })}`;
          a.textContent = l.name;
          const kind = document.createElement('span');
          kind.className = 'picker-kind';
          kind.textContent = ` (${l.type})`;
          li.append(a, kind);
          return li;
        }),
      );
      status.textContent = matches.length > shown.length
        ? `Showing ${shown.length} of ${matches.length} matches. Keep typing to narrow.`
        : `${matches.length} listing${matches.length === 1 ? '' : 's'}.`;
    };
    filter.addEventListener('input', render);
    render();
  }
</script>

<style is:global>
  /* Global: chat/hints nodes are created at runtime and carry no Astro scope attribute. */
  .update-page { padding-top: 24px; padding-bottom: 48px; }
  .update-explainer { max-width: 760px; margin-bottom: 28px; }
  .update-noscript { padding: 12px 14px; border: 1px solid var(--pink); border-radius: var(--radius); background: var(--white); }
  .update-picker label { display: block; font-weight: 600; margin-bottom: 6px; color: var(--text-dark); }
  .update-picker input { width: 100%; max-width: 480px; padding: 10px 12px; font-size: 16px; border: 1px solid var(--border-light); border-radius: var(--radius); }
  .picker-status { font-size: 14px; margin: 8px 0; }
  .picker-list { list-style: none; padding: 0; margin: 0; max-width: 760px; }
  .picker-list li { padding: 8px 0; border-bottom: 1px solid var(--border-light); }
  .picker-kind { font-size: 13px; }
  .update-panels { display: grid; grid-template-columns: 3fr 2fr; gap: 24px; align-items: start; }
  .update-panels > * { min-width: 0; }
  .update-chat, .update-hints { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px 18px; min-height: 280px; }
  .chat-transcript { min-height: 120px; display: flex; flex-direction: column; gap: 12px; margin-bottom: 12px; }
  .chat-msg { max-width: 88%; padding: 10px 14px; border-radius: 12px; }
  .chat-assistant { align-self: flex-start; background: var(--purple-faint); border: 1px solid var(--purple-light); border-top-left-radius: 2px; }
  .chat-user { align-self: flex-end; background: var(--dark); color: var(--white); border-top-right-radius: 2px; }
  .chat-user a { color: var(--white); text-decoration: underline; }
  .chat-who { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.75; margin-bottom: 2px; }
  .chat-assistant .chat-who { color: var(--purple-dark); opacity: 1; }
  .chat-text p { margin: 0 0 8px; overflow-wrap: anywhere; }
  .chat-text p:last-child { margin-bottom: 0; }
  .chat-assistant .chat-text { color: var(--text-dark); }
  .chat-form { margin-top: 8px; }
  .chat-form label { display: block; font-weight: 600; margin: 0 0 6px; color: var(--text-dark); }
  .chat-form textarea { display: block; width: 100%; box-sizing: border-box; min-height: 6em; resize: vertical; padding: 10px 12px; font-size: 16px; border: 1px solid var(--border-light); border-radius: var(--radius); font-family: inherit; }
  .chat-form .chat-send { margin-top: 10px; }
  .hints-confirm { margin-top: 8px; }
  .chat-restart, .chat-retry { margin-top: 10px; }
  .chat-send:disabled, .hints-confirm:disabled { opacity: 0.5; cursor: not-allowed; }
  .chat-hint, .chat-status { font-size: 14px; margin: 6px 0; }
  .chat-turns { font-size: 13px; color: var(--text); opacity: 0.85; margin: 0 0 8px; }
  .chat-notice { padding: 8px 10px; border: 1px solid var(--border-light); border-radius: var(--radius); font-size: 14px; overflow-wrap: anywhere; }
  .hints-sub { font-size: 16px; margin: 12px 0 4px; }
  .hints-list { padding-left: 18px; margin: 0 0 8px; }
  .hints-list li, .hints-empty { overflow-wrap: anywhere; word-break: break-word; margin-bottom: 4px; }
  .hints-done { font-weight: 600; }
  @media (max-width: 767px) {
    .update-panels { grid-template-columns: 1fr; }
    .chat-msg { max-width: 96%; }
  }
</style>
