# Copy to docker/.env and edit before running the beta container.
# docker compose reads .env from the compose file's own directory.

# Public hostname Caddy should route to this container. Leave empty to run
# it on the published port only, with no Caddy route.
SITE_HOSTNAME=

# Origin baked into the build. Must match how the beta is actually reached,
# or llms.txt and /for-agents will advertise URLs that do not resolve.
SITE_URL=http://localhost:8080

# Host port published to the container's port 80.
PORT=8080
