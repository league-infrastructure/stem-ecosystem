# shellcheck shell=bash
# Source this file (do not execute it) to decode a secrets bundle into
# exported environment variables.
#
# The bundle is base64 of KEY=value lines. If $SCRAPER_SECRETS_FILE is set it
# names a file holding the bundle (e.g. a swarm secret at /run/secrets/...)
# and takes precedence; a missing or unreadable file is an error. Otherwise
# it is read from $SCRAPER_SECRETS_B64 or from the variable whose name is in
# $SCRAPER_SECRETS_VAR. Build one with make-secrets.sh. Unset or empty
# bundle (or empty file) is a no-op. Variables already set
# in the environment win over bundle values. Nothing is eval'd and error
# messages never include values.

_load_secrets() {
  local var="${SCRAPER_SECRETS_VAR:-SCRAPER_SECRETS_B64}"
  if ! [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "load-secrets: SCRAPER_SECRETS_VAR is not a valid variable name" >&2
    return 1
  fi
  local b64
  if [ -n "${SCRAPER_SECRETS_FILE:-}" ]; then
    if [ ! -f "$SCRAPER_SECRETS_FILE" ] || [ ! -r "$SCRAPER_SECRETS_FILE" ]; then
      echo "load-secrets: \$SCRAPER_SECRETS_FILE is not a readable file" >&2
      return 1
    fi
    if ! b64="$(cat -- "$SCRAPER_SECRETS_FILE" 2>/dev/null)"; then
      echo "load-secrets: \$SCRAPER_SECRETS_FILE could not be read" >&2
      return 1
    fi
    var=SCRAPER_SECRETS_FILE
  else
    b64="${!var:-}"
  fi
  b64="${b64//[[:space:]]/}"
  [ -n "$b64" ] || return 0

  b64="${b64//[[:space:]]/}"
  if ! [[ "$b64" =~ ^[A-Za-z0-9+/]+=*$ ]] || [ $(( ${#b64} % 4 )) -ne 0 ]; then
    echo "load-secrets: \$$var is not valid base64" >&2
    return 1
  fi
  local decoded
  if ! decoded="$(printf '%s' "$b64" | base64 -d 2>/dev/null)"; then
    echo "load-secrets: \$$var could not be base64-decoded" >&2
    return 1
  fi

  local -a keys=() vals=()
  local line key val n=0 first last
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in '' | '#'*) continue ;; esac
    line="${line#export }"
    if [[ "$line" != *=* ]]; then
      echo "load-secrets: line $n is not KEY=value" >&2
      return 1
    fi
    key="${line%%=*}"
    val="${line#*=}"
    if ! [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo "load-secrets: line $n has an invalid key name" >&2
      return 1
    fi
    if [ "${#val}" -ge 2 ]; then
      first="${val:0:1}"
      last="${val: -1}"
      if [ "$first" = "$last" ] && { [ "$first" = '"' ] || [ "$first" = "'" ]; }; then
        val="${val:1:${#val}-2}"
      fi
    fi
    keys+=("$key")
    vals+=("$val")
  done <<<"$decoded"

  local i
  for i in "${!keys[@]}"; do
    key="${keys[$i]}"
    [ -z "${!key+x}" ] || continue
    export "$key=${vals[$i]}"
  done
}

_load_secrets
_load_secrets_rc=$?
unset -f _load_secrets
# shellcheck disable=SC2317  # reachable when sourced
return "$_load_secrets_rc" 2>/dev/null || exit "$_load_secrets_rc"
