#!/usr/bin/env bash
# Run one scraper job with secret preflight and timestamped result logging.
#
#   run-job scrape|teams|directory [extra partner-scrape args...]
#
# Log lines (stdout):
#   <UTC ISO ts> START job=X
#   <UTC ISO ts> SUCCESS job=X exit=0 duration=Ns
#   <UTC ISO ts> FAILURE job=X exit=N duration=Ns
#   <UTC ISO ts> FAILURE job=X missing=VAR1,VAR2        (preflight; not run)
# Only variable names are ever logged, never values. Exits with the job's
# status; 2 for usage errors; 1 for preflight failure.
#
# Full output is also uploaded to logs/<type>/<ts>-<job>.log in the bucket
# with a line in logs/index.jsonl (see partner_scrape/logs.py).
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

usage() {
  echo "usage: run-job scrape|teams|directory [extra args...]" >&2
  exit 2
}

[ $# -ge 1 ] || usage
job="$1"
shift

case "$job" in
  scrape)
    cmd=(partner-scrape)
    required=(DO_SPACES_ACCESS_KEY DO_SPACES_SECRET_KEY ANTHROPIC_API_KEY LEAGUESYNC_API_KEY)
    ;;
  teams)
    cmd=(partner-scrape teams)
    required=(DO_SPACES_ACCESS_KEY DO_SPACES_SECRET_KEY ANTHROPIC_API_KEY TBA_KEY)
    ;;
  directory)
    cmd=(partner-scrape directory)
    required=(DO_SPACES_ACCESS_KEY DO_SPACES_SECRET_KEY)
    ;;
  *) usage ;;
esac

has_arg() {
  local want="$1" a
  shift
  for a in "$@"; do [ "$a" = "$want" ] && return 0; done
  return 1
}

# Waive ANTHROPIC_API_KEY where the job will not call the LLM.
waive_anthropic=0
case "$job" in
  scrape)
    if has_arg --no-enrich "$@" || has_arg --dry-run "$@"; then waive_anthropic=1; fi
    ;;
  teams)
    if has_arg --no-sponsors "$@" && has_arg --no-descriptions "$@"; then waive_anthropic=1; fi
    ;;
esac

# The job body runs in a pipeline so stdout+stderr are teed to a temp file
# (still reaching `docker logs`) for upload to logs/ in the bucket on exit.
run_body() {
  echo "$(ts) START job=$job"
  SECONDS=0

  # shellcheck source=load-secrets
  if ! . "$here/load-secrets"; then
    echo "$(ts) FAILURE job=$job exit=1 duration=${SECONDS}s"
    exit 1
  fi

  missing=()
  for v in "${required[@]}"; do
    if [ "$v" = ANTHROPIC_API_KEY ] && [ "$waive_anthropic" -eq 1 ]; then continue; fi
    [ -n "${!v:-}" ] || missing+=("$v")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    names="$(IFS=,; echo "${missing[*]}")"
    echo "$(ts) FAILURE job=$job missing=$names"
    exit 1
  fi

  "${cmd[@]}" "$@"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "$(ts) SUCCESS job=$job exit=0 duration=${SECONDS}s"
  else
    echo "$(ts) FAILURE job=$job exit=$rc duration=${SECONDS}s"
  fi
  exit "$rc"
}

logfile="$(mktemp "${TMPDIR:-/tmp}/run-job.XXXXXX")"
trap 'rm -f "$logfile"' EXIT
start="$(ts)"
SECONDS=0
run_body "$@" 2>&1 | tee "$logfile"
rc=${PIPESTATUS[0]}
duration=$SECONDS
end="$(ts)"

# Upload is best-effort: a failure is reported on stdout and never changes
# the job's exit code. Secrets are re-loaded here (the job body ran in a
# subshell); if that fails the upload simply fails and says so.
(
  . "$here/load-secrets" >/dev/null 2>&1
  partner-scrape logs upload --job "$job" --file "$logfile" --start "$start" \
    --end "$end" --exit-code "$rc" --duration "$duration"
) || echo "$(ts) WARNING job=$job log upload failed (exit code unchanged)"
exit "$rc"
