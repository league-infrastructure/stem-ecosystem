# partner-scrape "updates" sidecar: the Starlette/uvicorn HTTP service behind
# updates.jtlapp.net (partner update-agent chat). Slim Python image -- no
# Playwright/Chromium, no scheduler. State lives in the DigitalOcean Spaces
# bucket; nothing is stored on local disk.
#
# Build from the repo root (the build context is scraper/ only; the
# per-image ignore list is Dockerfile.sidecar.dockerignore):
#
#   docker build -f scraper/docker/Dockerfile.sidecar -t partner-scrape-updates .
#
# Secrets are NOT baked in; the entrypoint loads the bundle named by
# SCRAPER_SECRETS_FILE (a swarm secret) via load-secrets. See README.md.
FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

# Dependencies first so source edits don't invalidate this layer.
COPY scraper/pyproject.toml scraper/uv.lock ./
RUN uv sync --locked --no-dev --extra sidecar --no-install-project

# The wheel build force-includes docs/data-schema.md (see pyproject.toml).
COPY scraper/partner_scrape ./partner_scrape
COPY scraper/docs/data-schema.md ./docs/data-schema.md
RUN uv sync --locked --no-dev --extra sidecar --no-editable

# Non-secret defaults; override with -e. UPDATES_* limits are documented in
# scraper/docker/README.md.
ENV DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com \
    TZ=America/Los_Angeles \
    PYTHONUNBUFFERED=1 \
    UPDATES_PORT=8000

COPY scraper/docker/sidecar-entrypoint.sh scraper/docker/load-secrets /usr/local/bin/
RUN chmod 0755 /usr/local/bin/sidecar-entrypoint.sh \
    && useradd --system --uid 10001 --no-create-home updates
USER updates

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request as u; u.urlopen('http://127.0.0.1:%s/healthz' % os.environ.get('UPDATES_PORT','8000'), timeout=3)"]

ENTRYPOINT ["sidecar-entrypoint.sh"]
