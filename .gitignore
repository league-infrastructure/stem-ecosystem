# Dependencies
node_modules/

# Data published by partner-scrape and pulled in by scripts/fetch-data.sh.
# Not tracked here: the pipeline's data/ is the source of truth, and a second
# tracked copy is what let a stale roster silently corrupt scraper runs.
# src/data/partners.json is the exception -- it is hand-curated in this repo
# and read by the pipeline, so it stays tracked.
src/data/*.json
!src/data/partners.json
public/data/
public/images/opportunities/

# Transient checkout made by the CI fetch step
.partner-scrape/

# Build output
dist/
.astro/

# Environment files
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Runtime data
*.pid
*.seed
*.pid.lock
# dotconfig — assembled env files contain decrypted secrets
